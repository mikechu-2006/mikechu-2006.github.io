---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPublishedPosts, collectTags } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = collectTags(posts);
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`标签 #${tag} 下的全部文章。`} active="tags">
  <div class="wrap">
    <p class="hero-kicker" style="margin-bottom: 0.6rem;">
      <a href="/tags" style="color: inherit;">← 所有标签</a>
    </p>
    <h1 class="page-title">#{tag}</h1>
    <p class="page-lead">{posts.length} 篇文章</p>
    <PostList posts={posts} />
  </div>
</BaseLayout>
