---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="404 — 这个页面不存在。" noindex>
  <div class="wrap" style="text-align: center; padding-block: 5rem;">
    <p class="hero-kicker">Error 404</p>
    <h1 class="page-title">这里什么都没有</h1>
    <p class="page-lead">链接可能已经失效，或者文章被我删掉了。</p>
    <a class="chip" href="/">← 回到首页</a>
  </div>
</BaseLayout>
