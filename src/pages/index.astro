---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../consts';
import { getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();
const recent = posts.slice(0, 6);
---

<BaseLayout active="home">
  <div class="wrap">
    <section class="hero">
      <p class="hero-kicker">Notes on code &amp; life</p>
      <h1>你好，我是{SITE.author}。</h1>
      <p>这里记录技术笔记、阅读摘录和一些想不明白的问题。写作是为了把话说清楚，顺便留下一点点时间的痕迹。</p>
      <div class="hero-links">
        <a class="chip" href="/archives">全部文章 →</a>
        {SITE.social.github && <a class="chip" href={SITE.social.github} rel="me">GitHub</a>}
        <a class="chip" href="/rss.xml">RSS 订阅</a>
      </div>
    </section>

    <section aria-labelledby="recent">
      <div class="section-head">
        <h2 id="recent">最近文章</h2>
        <a href="/archives">共 {posts.length} 篇 →</a>
      </div>
      <PostList posts={recent} />
    </section>
  </div>
</BaseLayout>
